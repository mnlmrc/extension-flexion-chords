{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "searchlight encoding",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "searchlight_encoding_session",
                "--glm",
                "1",
                "--sns",
                "101",
                "102"
            ]
        },
        {
            "name": "behaviour",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/behaviour.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "make searchlight",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "make_searchlight",
                "--sns",
                "101"
            ]
        },
        {
            "name": "make_cifti_residual",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "make_cifti_residual",
                "--sns",
                "101"
            ]
        }
    ]
}